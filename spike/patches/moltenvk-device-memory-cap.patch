+	} else {
+		uint64_t freeMem = mvkGetAvailableMemorySize();
+		size = freeMem ? freeMem : 256 * MEBI;
 	}
-	uint64_t freeMem = mvkGetAvailableMemorySize();
-	return freeMem ? freeMem : 256 * MEBI;
